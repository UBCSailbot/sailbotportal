# Required, local values come from `supabase status -o env`
# (API_URL, ANON_KEY and SERVICE_ROLE_KEY there).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, public posting reads fall back to Supabase without these.
FREDB_API_KEY=
FREDB_BASE_URL=

# Optional, the rest of `supabase status -o env`, handy for tools and scripts.
# The app does not read any of these.
DB_URL=
REST_URL=
GRAPHQL_URL=
FUNCTIONS_URL=
STORAGE_S3_URL=
STUDIO_URL=
MAILPIT_URL=
MCP_URL=
JWT_SECRET=
PUBLISHABLE_KEY=
SECRET_KEY=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
S3_PROTOCOL_REGION=
